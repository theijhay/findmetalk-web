# Copy to .env.local for local development: `cp .env.example .env.local`.
# Every variable the deployment needs is listed here, with what it gates.

# Where the Next.js server reaches findmetalk-api. Server-only: it is never
# sent to the browser, which calls /api/v1/* on this app's own origin instead.
# Local: the API from `make run` in findmetalk-api.
API_URL=http://localhost:8000

# The public origin of this app, used for absolute links and metadata.
APP_URL=http://localhost:3000
